# GitHub username (lowercase) - replace with your GitHub username
GITHUB_USERNAME=your-github-username

# Glances server configuration (optional - only needed if using external Glances)
# If not set, Glances will run in a container alongside the UI
# GLANCES_HOST=external-glances-server
GLANCES_PORT=61208

# UI Port (the port where GlancesUI will be accessible)
UI_PORT=3000
